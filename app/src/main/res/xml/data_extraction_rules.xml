<?xml version="1.0" encoding="utf-8"?><!--
   Used on Android 12 and newer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The action log is never uploaded. See EventLogDatabase -->
        <exclude domain="database" path="focus_timer_log" />
        <exclude domain="database" path="focus_timer_log-wal" />
        <exclude domain="database" path="focus_timer_log-shm" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
