<?xml version="1.0" encoding="utf-8"?><!--
   Used on Android 11 and older.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
-->
<full-backup-content>
    <!-- The action log is never uploaded. See EventLogDatabase -->
    <exclude domain="database" path="focus_timer_log" />
    <exclude domain="database" path="focus_timer_log-wal" />
    <exclude domain="database" path="focus_timer_log-shm" />
    <!-- A session in progress means nothing on another phone -->
    <exclude domain="sharedpref" path="focus_session.xml" />
</full-backup-content>
